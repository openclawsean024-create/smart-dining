{
  "name": "@smart-dining/kiosk",
  "version": "0.1.0",
  "private": true,
  "description": "KIOSK tablet self-ordering frontend (React + Vite + TS + Tailwind)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
