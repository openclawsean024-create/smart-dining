{
  "name": "smart-dining",
  "version": "0.1.0",
  "private": true,
  "description": "餐飲點餐快手 — Smart Dining Self-Ordering & Tracking System",
  "workspaces": [
    "shared-contracts",
    "backend",
    "kiosk-frontend",
    "mobile-app"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "rm -rf */dist */node_modules ./*.db",
    "build:kiosk": "npm run build -w @smart-dining/contracts && npm run build -w @smart-dining/kiosk",
    "build:mobile": "npm run build -w @smart-dining/contracts && npm run build -w @smart-dining/mobile",
    "build:all": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "npm run build -w @smart-dining/contracts && playwright test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
