{
  "name": "@smart-dining/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:seed": "tsx src/seed.ts",
    "db:reset": "rm -f data/dev.db && prisma db push --schema=./prisma/schema.prisma && tsx src/seed.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "test:api": "bash scripts/test-api.sh",
    "test:ws": "node scripts/ws-test.mjs"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@prisma/client": "^5.20.0",
    "@smart-dining/contracts": "*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "nanoid": "^5.0.7",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8",
    "@fastify/websocket": "^8.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.5",
    "prisma": "^5.20.0",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
