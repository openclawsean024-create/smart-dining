# Production env — 由 Railway 自動產生 DATABASE_URL(JWT_SECRET 需要手動加)
# Node
NODE_ENV=production
PORT=4000

# Database(Railway 自動注入 DATABASE_URL 給 Postgres)
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# JWT(用 openssl rand -hex 32 產生)
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# CORS(改成你的前端正式網址,逗號分隔)
CORS_ORIGIN=https://smart-dining-kiosk.vercel.app,https://smart-dining-mobile.vercel.app
