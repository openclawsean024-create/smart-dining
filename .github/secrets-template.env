# secrets-template.env — smart-dining automation bundle
# =====================================================
#
# Generated from `repo-builder --automation` on smart-dining.
# Lists the *names* of secrets you must set in GitHub Actions.
# Does NOT contain secret values — never commit secrets to git.
#
# Where to set them:
#   https://github.com/openclawsean024-create/smart-dining/settings/secrets/actions
#
# Where to get each value:
#   See docs/AUTOMATION.md § "Layer N — Required secrets"

# ─────────────────────────────────────────────────────────────────────────
# Required: Vercel deploy (KIOSK + mobile, 2 projects)
# ─────────────────────────────────────────────────────────────────────────
# One token deploys to both projects. Get at:
#   https://vercel.com/account/settings/tokens
VERCEL_TOKEN=

# Vercel org ID (found in Vercel project settings → General)
VERCEL_ORG_ID=

# Project ID for each frontend (found in Vercel project settings → General)
# The repo has two vercel.*.json files (monorepo); each maps to one project.
VERCEL_KIOSK_PROJECT_ID=
VERCEL_MOBILE_PROJECT_ID=

# ─────────────────────────────────────────────────────────────────────────
# Required: Railway deploy (backend, single service with 2 environments)
# ─────────────────────────────────────────────────────────────────────────
# Get at: https://railway.app/account/tokens
RAILWAY_TOKEN=

# Railway service name (the one created from backend/railway.json).
# Default: smart-dining-backend. Override only if you renamed it.
RAILWAY_SERVICE=smart-dining-backend

# ─────────────────────────────────────────────────────────────────────────
# Required for prod deploy: tagging + rollback workflow
# ─────────────────────────────────────────────────────────────────────────
# PAT with `contents:write`. Create at:
#   https://github.com/settings/tokens?type=beta
PROD_DEPLOY_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# Optional: Slack failure notifications
# ─────────────────────────────────────────────────────────────────────────
# Create at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────
# Required for auto-rollback from Sentry
# ─────────────────────────────────────────────────────────────────────────
# Same PAT as PROD_DEPLOY_TOKEN. Set up Sentry webhook →
# see docs/AUTOMATION.md § "Layer 4"
SENTRY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Smart-dining context
# ─────────────────────────────────────────────────────────────────────────
# Repo:    https://github.com/openclawsean024-create/smart-dining
# Branch:  main (prod), staging (staging)
# Targets: Vercel × 2 (KIOSK + mobile) + Railway × 1 (backend)

# ─────────────────────────────────────────────────────────────────────────
# DO NOT COMMIT THIS FILE.
# Add it to .gitignore and delete after copying the secret *names* to GitHub.
# ─────────────────────────────────────────────────────────────────────────
